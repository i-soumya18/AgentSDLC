{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://engineering-os.dev/schemas/context-pack.schema.json",
  "title": "Agent Context Pack",
  "description": "Canonical representation of the minimum sufficient context compiled for an AI agent task",
  "type": "object",
  "required": [
    "mission",
    "role",
    "constraints",
    "requirements",
    "relevant_artifacts",
    "relevant_files",
    "relevant_tests",
    "decisions",
    "assumptions",
    "known_risks",
    "forbidden_actions"
  ],
  "properties": {
    "version": {
      "type": "string",
      "default": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "type": ["string", "null"]
    },
    "target_role": {
      "type": "string"
    },
    "hierarchy_level": {
      "type": "string",
      "enum": ["L0", "L1", "L2", "L3", "L4", "L5"]
    },
    "mission": {
      "type": "object",
      "required": ["goal", "summary"],
      "properties": {
        "goal": { "type": "string" },
        "summary": { "type": "string" },
        "deliverables": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "role": {
      "type": "object",
      "required": ["name", "code_access", "authority"],
      "properties": {
        "name": { "type": "string" },
        "code_access": { "type": "string" },
        "authority": { "type": "string" },
        "primary_focus": { "type": "string" }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "source", "reason"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "source": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "reason"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "acceptance_criteria": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "relevant_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "type", "reason"],
        "properties": {
          "path": { "type": "string" },
          "type": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "relevant_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string" },
          "role": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "relevant_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string" },
          "type": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "summary", "reason"],
        "properties": {
          "id": { "type": "string" },
          "summary": { "type": "string" },
          "status": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "reason"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "known_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "reason"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string" },
          "description": { "type": "string" },
          "mitigation": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "forbidden_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "total_characters": { "type": "integer" },
        "estimated_tokens": { "type": "integer" },
        "compression_ratio": { "type": "number" },
        "items_included": { "type": "integer" },
        "items_filtered": { "type": "integer" },
        "relevance_score": { "type": "number" }
      }
    },
    "audit_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "status", "reason"],
        "properties": {
          "item": { "type": "string" },
          "status": { "type": "string", "enum": ["INCLUDED", "FILTERED", "EXCLUDED"] },
          "reason": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
