{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://engineering-os.dev/schemas/screen-specification.schema.json",
  "title": "Screen Specification",
  "description": "Specification for user interface screens with wireframe layout, user journey step, and explicit requirement traceability",
  "type": "object",
  "required": [
    "id",
    "title",
    "route",
    "layout_archetype",
    "requirement_ids",
    "journey_stage",
    "user_flow_step",
    "components",
    "wireframe",
    "error_handling",
    "responsive_adaptations"
  ],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "route": { "type": "string" },
    "layout_archetype": {
      "type": "string",
      "enum": ["single-column", "dashboard", "split-view", "modal-flow", "master-detail", "canvas"]
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "journey_stage": { "type": "string" },
    "user_flow_step": { "type": "string" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "wireframe": {
      "type": "object",
      "required": ["header", "main_content"],
      "properties": {
        "header": { "type": "string" },
        "sidebar": { "type": "string" },
        "main_content": { "type": "string" },
        "footer": { "type": "string" },
        "modal_overlays": { "type": "string" }
      }
    },
    "error_handling": {
      "type": "object",
      "required": ["network_failure", "validation_error", "empty_state"],
      "properties": {
        "network_failure": { "type": "string" },
        "validation_error": { "type": "string" },
        "empty_state": { "type": "string" }
      }
    },
    "responsive_adaptations": {
      "type": "object",
      "required": ["mobile", "desktop"],
      "properties": {
        "mobile": { "type": "string" },
        "tablet": { "type": "string" },
        "desktop": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
